generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        String @id
  publicKey String
  createdAt DateTime @default(now())
}

model MemoryBlock {
  id        String @id
  userId    String
  encryptedData String
  createdAt DateTime @default(now())
}

model PreferenceGraph {
  id     String @id
  userId String
  data   String // JSON
}

model Organization {
  id        String        @id
  name      String
  plan      String
  members   TeamMember[]
  auditLogs AuditLog[]
}

model TeamMember {
  id             String       @id
  userId         String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  role           String       // "owner", "admin", "member", "viewer"
}

model AuditLog {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  userId         String
  action         String
  details        String
  createdAt      DateTime     @default(now())
}
